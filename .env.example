# ============================================================
# ARC
# Environment configuration
# ============================================================


# ------------------------------------------------------------
# Supabase — Public
# Safe for browser use
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ------------------------------------------------------------
# Supabase — Server only
#
# NEVER prefix this with NEXT_PUBLIC_.
# NEVER commit your real key.
# ------------------------------------------------------------

SUPABASE_SECRET_KEY=


# ------------------------------------------------------------
# ARC Runtime
#
# Production-safe default is false.
# Only use true intentionally for the mock/demo POS.
# ------------------------------------------------------------

NEXT_PUBLIC_ARC_DEMO_MODE=false

# Optional canonical HTTPS URL used for phone scanner pairing.
# Leave blank to use the current browser origin.
NEXT_PUBLIC_ARC_PUBLIC_URL=




# ------------------------------------------------------------
# ARC Platform Admin
#
# Server-only hidden portal key.
# Never prefix this with NEXT_PUBLIC_.
# Use a long random value in Vercel / local .env.
# ------------------------------------------------------------

ARC_PLATFORM_PORTAL_KEY=
