# ============================================================
# NOVA POS
# Environment configuration
# ============================================================


# ------------------------------------------------------------
# Supabase — Public
# Safe for browser use
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ------------------------------------------------------------
# Supabase — Server only
#
# NEVER prefix this with NEXT_PUBLIC_.
# NEVER commit your real key.
# ------------------------------------------------------------

SUPABASE_SECRET_KEY=


# ------------------------------------------------------------
# NOVA Runtime
#
# Production-safe default is false.
# Only use true intentionally for the mock/demo POS.
# ------------------------------------------------------------

NEXT_PUBLIC_NOVA_DEMO_MODE=false


# ------------------------------------------------------------
# Optional legacy catalog filter
#
# Leave empty for normal authenticated/RLS operation.
# ------------------------------------------------------------

NEXT_PUBLIC_NOVA_BUSINESS_ID=